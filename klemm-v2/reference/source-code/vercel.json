{
  "framework": null,
  "buildCommand": "node tools/build-site.mjs",
  "outputDirectory": "dist/client",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.+?)/?",
      "dest": "/$1.html",
      "check": true
    },
    {
      "src": "/(.+?)/?",
      "dest": "/$1/index.html",
      "check": true
    },
    {
      "src": "^/listings(?:\\.html)?/?$",
      "status": 307,
      "headers": {
        "Location": "https://pages.klemmre.com/featured-listings/"
      }
    },
    {
      "src": "^/reviews(?:\\.html)?/?$",
      "status": 307,
      "headers": {
        "Location": "https://pages.klemmre.com/testimonials/"
      }
    },
    {
      "src": "^/(.*?)(?:\\.html)?(?:/index\\.html)?$",
      "status": 307,
      "headers": {
        "Location": "https://pages.klemmre.com/$1"
      }
    }
  ]
}
